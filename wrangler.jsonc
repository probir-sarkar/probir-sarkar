{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "probir-sarkar",
  "compatibility_date": "2026-06-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "CHAT_SESSIONS",
      "id": "4bb50b9587df4015b36cfc27de903225",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "probir-sarkar-db",
      "database_id": "6d7e8a8b-9855-4015-93d4-b4f93279db8b",
      "remote": false,
      "migrations_dir": "drizzle/migrations",
      "migrations_pattern": "drizzle/migrations/*/migration.sql",
    },
  ],
}
